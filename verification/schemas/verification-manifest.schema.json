{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "runId", "planId", "lane", "startedAt", "completedAt", "planDigest", "environment", "toolVersions", "restrictedEvidenceIds", "evidenceAvailable", "resultIds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^VM-[0-9]{4}$"},
    "runId": {"type": "string", "pattern": "^RUN-[0-9]{4}$"},
    "planId": {"type": "string", "pattern": "^VP-[0-9]{4}$"},
    "lane": {"enum": ["public", "restricted"]},
    "startedAt": {"type": "string"}, "completedAt": {"type": "string"},
    "planDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment": {"type": "object", "additionalProperties": false, "required": ["name", "metadataDigest"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "metadataDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "toolVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "restrictedEvidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-[0-9a-f]{16}$"}},
    "evidenceAvailable": {"type": "boolean"},
    "resultIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^VR-[0-9]{4}$"}}
  }
}
