{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "status", "aliases", "claimScopes", "verificationArea", "executionTiers", "dependencies", "applicability", "initialState", "actions", "expectedObservables", "acceptanceEnvelopes", "verification", "reviewRequired"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^BC-[0-9]{4}$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "provisional", "verified"]},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:BC|MAS|CSM)-[0-9]{4}$"}},
    "claimScopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fidelity", "release-readiness"]}},
    "verificationArea": {"enum": ["provenance", "geometry", "semantics", "rendering", "journey", "saves", "native-shell", "content", "security", "compatibility"]},
    "executionTiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["public-ci", "release-candidate"]}},
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseIds", "uncertaintyIds", "evidenceIds"],
      "properties": {
        "caseIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^BC-[0-9]{4}$"}},
        "uncertaintyIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^UNC-[0-9]{4}$"}},
        "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-[0-9a-f]{16}$"}}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateKinds"],
      "properties": {"candidateKinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["official", "modded"]}}}
    },
    "initialState": {"type": "string", "minLength": 1},
    "actions": {"type": "string", "minLength": 1},
    "expectedObservables": {"type": "string", "minLength": 1},
    "acceptanceEnvelopes": {"type": "string", "minLength": 1},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "oracleDiagnosticRequired"],
      "properties": {"method": {"type": "string", "minLength": 1}, "oracleDiagnosticRequired": {"type": "boolean"}}
    },
    "reviewRequired": {"type": "boolean"},
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "materiality", "crackSensitivity", "dimensions", "evidenceIds", "researchProvenance", "departureIds"],
      "properties": {
        "classification": {"enum": ["required-behavior", "preserved-quirk", "repairable-artifact", "mac-adaptation", "excluded-crack-artifact"]},
        "materiality": {"enum": ["material", "non-material"]},
        "crackSensitivity": {"enum": ["retail-corroborated", "crack-sensitive", "not-applicable"]},
        "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["audio", "content", "controls", "nondeterminism", "outcome", "saves", "state", "timing", "visuals"]}},
        "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-[0-9a-f]{16}$"}},
        "researchProvenance": {"type": "string", "minLength": 1},
        "departureIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^DR-[0-9]{4}$"}}
      }
    }
  }
}
