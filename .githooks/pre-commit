#!/bin/sh
# Installed by scripts/worktree-setup.sh through core.hooksPath.
cd "$(git rev-parse --show-toplevel)/web" || exit 1
if [ ! -d node_modules ]; then
  echo "pre-commit: web/node_modules is missing; run scripts/worktree-setup.sh" >&2
  exit 1
fi
bun run --silent typecheck && bun run --silent lint && bun run --silent format:check
