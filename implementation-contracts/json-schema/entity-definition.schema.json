{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercenary.invalid/schema/v1/entity-definition.schema.json",
  "title": "EntityDefinition v1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schemaMajor", "schemaMinor", "id", "propertySchemaIds", "properties", "relationships"],
  "properties": {
    "schemaMajor": {"const": 1}, "schemaMinor": {"const": 0},
    "id": {"type": "string", "maxLength": 255},
    "propertySchemaIds": {"type": "array", "maxItems": 1024, "items": {"type": "string", "maxLength": 255}, "uniqueItems": true},
    "properties": {"type": "object", "maxProperties": 1024},
    "relationships": {"type": "array", "maxItems": 100000, "items": {"type": "string", "maxLength": 255}, "uniqueItems": true}
  }
}
