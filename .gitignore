# Supplied reference media remain research inputs, not repository content. The one
# tracked documentation exception is research/reference-disassembly (ADR 0017).
/roms/

# Other Restricted Material that does not belong to a specific research harness.
/restricted/

# The Data Payload: game data re-extracted from the Reference Build, loaded by
# the app at runtime. Never tracked (ADR 0014).
/payload/

# Generated C64 laboratory artifacts may contain ROM-derived data.
/research/c64-reference-build/work/
/research/c64-reference-build/.venv/

# Generated Damocles ST laboratory artifacts may contain ROM-derived data.
/research/damocles-st/work/
/research/damocles-st/.venv/

# Python development artifacts.
__pycache__/
*.py[cod]

# Throwaway native-prototype build products.
/prototypes/macos-experience/.build/

# Swift build products for the app.
/app/.build/

# Golden traces emitted by the Trace Oracle. Derived from the Data Payload and
# therefore never tracked (ADR 0019).
/traces/

# Web build products. A bundled browser build embeds payload-derived data
# (ADR 0019).
/web/dist/
/web/node_modules/
/web/.eslintcache
/web/playwright-report/
/web/test-results/
.DS_Store
