{
  "name": "mercenary-web",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "scripts": {
    "changelog": "bun ../tools/commits/changelog.ts",
    "changelog:release": "bun ../tools/commits/changelog.ts release",
    "check": "bun run typecheck && bun run typecheck:research && bun run lint && bun run format:check && bun run check:docs && bun run test:quiet && bun run test:tools",
    "check:docs": "bun run check:docs:portable && bun tools/check-restricted-citations.ts",
    "check:docs:portable": "bun tools/doc-links.ts && bun tools/adr-index.ts --check",
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "dev": "bun run serve.ts",
    "dion:identity": "bun tools/dion-identity.ts",
    "format": "prettier --write --config .prettierrc . ../tools",
    "format:check": "prettier --check --config .prettierrc . ../tools",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:quiet": "bun test --only-failures",
    "test:tools": "bun test ../tools",
    "typecheck": "tsc --noEmit",
    "typecheck:research": "tsc --noEmit -p tsconfig.research.json",
    "unused": "knip"
  },
  "knip": {
    "entry": [
      "src/shell/boot.ts",
      "src/atlas/boot.ts",
      "src/catalogue/boot.ts",
      "src/damocles/boot.ts",
      "src/dion/boot.ts",
      "src/dionCatalogue/boot.ts",
      "src/damocles/firstOfferDemo.ts",
      "src/soundboard/boot.ts",
      "src/soundboard/dionWorklet.ts",
      "src/flyover/boot.ts",
      "src/sound/worklet.ts",
      "src/damocles/soundWorklet.ts",
      "tools/sound-compare.ts",
      "tools/damocles-sound-render.ts",
      "tools/dion-scene.ts",
      "tools/dion-ram-compare.ts",
      "tools/dion-catalogue-compare.ts",
      "tools/dion-catalogue-coverage.ts",
      "tools/geometry-spike/*.ts",
      "e2e/opening-loop.ts",
      "e2e/wireframe-fixture.ts",
      "e2e/damocles-fixture.ts",
      "e2e/*.e2e.ts",
      "test/**/*.test.ts",
      "src/dion/soundWorklet.ts",
      "e2e/dion-fixture.ts",
      "e2e/rendering-fixture.ts",
      "tools/dion-tourcraft-compare.ts"
    ],
    "include": [
      "files",
      "dependencies",
      "unlisted",
      "unresolved"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.1",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}
