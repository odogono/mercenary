{
  "name": "mercenary-web",
  "private": true,
  "type": "module",
  "scripts": {
    "coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "dev": "bun run serve.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "outdated": "bunx npm-check-updates --interactive --format group",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "unused": "knip"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nkzw/eslint-config": "^3.3.0",
    "typescript": "^5.9.2",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.1",
    "knip": "^6.32.2",
    "prettier": "^3.9.6"
  }
}
