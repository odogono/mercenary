-- The Escape: launching the Interstellar Ship and the end of the game.
-- Rewritten from Benson Script 7 (payload/benson.json, instructions 411-460).

use show, report, prompt from benson

on boarded craft where craft = "ship", replacing
  show "INTERSTELLAR SHIP" and wait
  -- A World Event isn't buffered: one that arrived while the message played
  -- is gone, so check the world before waiting for it to change.
  if not aboard() then return
  ask world to here
  if it is not "surface" then
    wait for
      when entered room where room = "surface" then
      when left craft where craft = "ship" then
        return
    end wait
  end if
  if not canLaunch() then
    show "NOVADRIVE REQUIRED" and wait
    return
  end if
  -- The prompt holds Player Input until this Run ends, so no other Talk
  -- Script hears the Y.
  prompt "PRESS Y TO LAUNCH" and wait
  if not aboard() then return
  wait for
    when pressed key where key = "Y" then
    when left craft where craft = "ship" then
      return
  end wait
  ask world to advertIntact
  if it then
    escape and wait
  else
    report ["THE AUTHOR WON'T LET", "YOU LEAVE UNTIL YOU", "FIX HIS ADVERT"] and wait
  end if
end boarded

on escape
  ask world to escape
  wait 2 s
  ask world to setMessageInterval 150
  report ["THE AUTHOR SENDS YOU", "CONGRATULATIONS ON YOUR", "ESCAPE FROM TARG"] and wait
  ask world to flag "commanderAnnoyed"
  if it then
    report ["THE PALYAR COMMANDER'S", "BROTHER-IN-LAW", "IS PLEASED YOU'VE GONE"] and wait
  end if
  report ["SAVE OUT THE STATUS AND", "SEE YOU IN MERCENARY II"] and wait
  wait 15 s
  repeat forever
    wait 15 s
    show "GAME OVER" and wait
    tell sound to silence "voice1"
    tell sound to silence "voice2"
  end repeat
end escape

function aboard
  ask world to boarded
  return it = "ship"
end aboard

-- The ship needs a Novadrive, unless it was hired with one.
function canLaunch
  ask world to flag "shipHired"
  if it then return true
  ask world to carries "novadrive"
  return it
end canLaunch
