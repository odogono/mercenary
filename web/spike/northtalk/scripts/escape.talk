-- The Escape: launching the Interstellar Ship and the end of the game.
-- Rewritten from Benson Script 7 (payload/benson.json, instructions 411-460).
-- Boarding the ship starts it once the opening has armed object 7.

constant ship = 7

on begin
  show "INTERSTELLAR SHIP" and wait
  repeat forever
    -- Wait for the ship to stand on the surface, for as long as the player stays aboard.
    repeat while aboard() and not onSurface()
      wait 1 s
    end repeat
    if not aboard() then return
    wait 1 s
    if not canLaunch() then
      show "NOVADRIVE REQUIRED" and wait
      return
    end if
    show "PRESS Y TO LAUNCH" and wait
    awaitLaunch and wait
    if it is false then return
    if onSurface() and canLaunch() then exit repeat
  end repeat
  ask world to advertIntact
  if it then
    escape and wait
  else
    report ["THE AUTHOR WON'T LET", "YOU LEAVE UNTIL YOU", "FIX HIS ADVERT"] and wait
  end if
end begin

-- True once the player presses Y; false if they leave the ship first.
on awaitLaunch
  repeat forever
    ask keys to awaitKey "Y", 1 and wait
    if it then return true
    if not aboard() then return false
  end repeat
end awaitLaunch

on escape
  ask world to escape
  wait 2 s
  ask world to setMessageInterval 150
  report ["THE AUTHOR SENDS YOU", "CONGRATULATIONS ON YOUR", "ESCAPE FROM TARG"] and wait
  ask world to flag "commanderAnnoyed"
  if it then
    report ["THE PALYAR COMMANDER'S", "BROTHER-IN-LAW", "IS PLEASED YOU'VE GONE"] and wait
  end if
  report ["SAVE OUT THE STATUS AND", "SEE YOU IN MERCENARY II"] and wait
  wait 15 s
  repeat forever
    wait 15 s
    show "GAME OVER" and wait
    tell sound to silence "voice1"
    tell sound to silence "voice2"
  end repeat
end escape

function aboard
  ask world to boarded
  return it = ship
end aboard

function onSurface
  ask world to onSurface
  return it
end onSurface

-- The ship needs a Novadrive, unless it was hired with one.
function canLaunch
  ask world to flag "shipHired"
  if it then return true
  ask world to carries "novadrive"
  return it
end canLaunch

on show line
  ask display to show line and wait
end show

on report lines
  repeat for each line in lines
    show line and wait
  end repeat
end report
