use show, clear, report from benson

-- The Shrine (ADR 0084). Its placement names this script to answer for its
-- Surface Region, so what happens at the Shrine is told here and nowhere
-- else.

-- The player came near. The Shrine is at peace once the energy crystal is
-- fixed in it.
on approached
  ask world to fixed "energy crystal"
  if it then
    show "THE SHRINE IS AT PEACE" and wait
  else
    show "A SHRINE STANDS HERE" and wait
  end if
end approached

-- An object was left inside. The energy crystal is taken as an offering and
-- fixed where it lies, so it can't be left twice.
on received item
  if item = "energy crystal" then
    ask world to fix item
    report ["THE SHRINE", "ACCEPTS THE CRYSTAL", "IT WILL NOT BE MOVED"] and wait
    clear and wait
    return
  end if
  show "THE SHRINE IS INDIFFERENT" and wait
end received
