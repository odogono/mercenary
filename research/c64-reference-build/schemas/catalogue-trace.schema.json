{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odogono/mercenary/research/c64-reference-build/catalogue-trace.schema.json",
  "title": "C64 Behavior Catalogue trace",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "title", "mode", "branches"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^TR-[0-9]{4}$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "mode": {"enum": ["probe", "proof"]},
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "from", "actions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "from": {"type": "object"},
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {"type": {"type": "string"}},
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
