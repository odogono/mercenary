{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mercenary.invalid/schemas/geometry-curation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "names"],
  "properties": {
    "schemaVersion": {"const": 1},
    "names": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["geometryIdentity", "preferredName", "kind", "status", "evidence"],
        "properties": {
          "geometryIdentity": {"type": "string"},
          "preferredName": {"type": "string", "minLength": 1},
          "kind": {"enum": ["vehicle", "object", "surface", "room"]},
          "status": {"enum": ["verified", "candidate"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["authority", "reference"]}}
        }
      }
    }
  }
}
