{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odogono/mercenary/research/c64-reference-build/catalogue-trace-set.schema.json",
  "title": "C64 Behavior Catalogue trace set",
  "type": "object",
  "required": ["schemaVersion", "traces"],
  "properties": {
    "schemaVersion": {"const": 1},
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "repetitions"],
        "properties": {
          "path": {"type": "string", "pattern": "^traces/TR-[0-9]{4}[-a-z0-9]*\\.json$"},
          "kind": {"enum": ["deterministic", "stochastic"]},
          "repetitions": {"type": "integer", "minimum": 2},
          "legalOutcomes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "schedule": {
            "type": "object",
            "required": ["kind", "periodCycles"],
            "properties": {
              "kind": {"const": "stratified-pal"},
              "periodCycles": {"type": "integer", "minimum": 100}
            },
            "additionalProperties": false
          },
          "outcomeSource": {"enum": ["typed", "artifact-hash"]},
          "outcomeArtifactRole": {"type": "string", "minLength": 1},
          "outcomeHashes": {
            "type": "object",
            "propertyNames": {"pattern": "^[0-9a-f]{64}$"},
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
