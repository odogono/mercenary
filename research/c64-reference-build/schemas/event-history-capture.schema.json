{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odogono/mercenary/research/c64-reference-build/event-history-capture.schema.json",
  "title": "Bounded macOS VICE keyboard event-history capture request",
  "type": "object",
  "required": ["schemaVersion", "vicePid", "viceExecutableSha256", "windowOwner", "windowTitle", "durationMilliseconds", "eventHistory", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "vicePid": {"type": "integer", "minimum": 1},
    "viceExecutableSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "windowOwner": {"const": "x64sc"},
    "windowTitle": {"const": "VICE (C64SC)"},
    "durationMilliseconds": {"type": "integer", "minimum": 1, "maximum": 60000},
    "eventHistory": {
      "type": "object",
      "required": ["startSnapshotPath", "endSnapshotPath", "hotkeyFilePath", "hotkeyFileSha256"],
      "properties": {
        "startSnapshotPath": {"type": "string", "minLength": 1},
        "endSnapshotPath": {"type": "string", "minLength": 1},
        "hotkeyFilePath": {"type": "string", "minLength": 1},
        "hotkeyFileSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["atMilliseconds", "type", "keyCode"],
        "properties": {
          "atMilliseconds": {"type": "integer", "minimum": 0, "maximum": 60000},
          "type": {"enum": ["key-down", "key-up"]},
          "keyCode": {"type": "integer", "minimum": 0, "maximum": 127},
          "modifiers": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["command", "control", "option", "shift"]}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
