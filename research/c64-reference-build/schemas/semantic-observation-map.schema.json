{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odogono/mercenary/research/c64-reference-build/semantic-observation-map.schema.json",
  "title": "Restricted semantic observation map",
  "type": "object",
  "required": ["schemaVersion", "observations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "bank", "address", "width"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "type": {"enum": ["integer", "boolean", "enum"]},
          "bank": {"enum": ["ram", "cpu"]},
          "address": {"type": "integer", "minimum": 0, "maximum": 65535},
          "width": {"type": "integer", "minimum": 1, "maximum": 8},
          "endianness": {"enum": ["little", "big"]},
          "signed": {"type": "boolean"},
          "mask": {"type": "integer", "minimum": 0},
          "shift": {"type": "integer", "minimum": 0},
          "values": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "enum"}}}, "then": {"required": ["values"]}, "else": {"not": {"required": ["values"]}}}
        ],
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "address"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "address": {"type": "integer", "minimum": 0, "maximum": 65535}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
