{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odogono/mercenary/research/c64-reference-build/event-history-replay.schema.json",
  "title": "Bounded macOS VICE keyboard event-history replay activation",
  "type": "object",
  "required": ["schemaVersion", "vicePid", "viceExecutableSha256", "windowOwner", "windowTitle", "durationMilliseconds", "startSnapshotPath", "startSnapshotSha256", "hotkeyFilePath", "hotkeyFileSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "vicePid": {"type": "integer", "minimum": 1},
    "viceExecutableSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "windowOwner": {"const": "x64sc"},
    "windowTitle": {"const": "VICE (C64SC)"},
    "durationMilliseconds": {"type": "integer", "minimum": 1, "maximum": 60000},
    "startSnapshotPath": {"type": "string", "minLength": 1},
    "startSnapshotSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hotkeyFilePath": {"type": "string", "minLength": 1},
    "hotkeyFileSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
