+static void monitor_binary_process_keyboard_matrix_set(binary_command_t *command)
+{
+    if (command->length != KBD_ROWS) {
+        monitor_binary_error(e_MON_ERR_CMD_INVALID_LENGTH, command->request_id);
+        return;
+    }
+
+    keyboard_set_matrix(command->body);
+    monitor_binary_response(0, e_MON_RESPONSE_KEYBOARD_MATRIX_SET,
+                            e_MON_ERR_OK, command->request_id, NULL);
+}
+
+static void monitor_binary_process_keyboard_matrix_get(binary_command_t *command)
+{
+    uint8_t response[KBD_ROWS];
+    int row;
+
+    if (command->length != 0) {
+        monitor_binary_error(e_MON_ERR_CMD_INVALID_LENGTH, command->request_id);
+        return;
+    }
+    for (row = 0; row < KBD_ROWS; row++) {
+        response[row] = (uint8_t)keyarr[row];
+    }
+    monitor_binary_response(KBD_ROWS, e_MON_RESPONSE_KEYBOARD_MATRIX_GET,
+                            e_MON_ERR_OK, command->request_id, response);
+}
+
+static void monitor_binary_process_host_key_event(binary_command_t *command)
+{
+    unsigned char *body = command->body;
+    uint32_t key;
+    uint16_t modifiers;
+    uint8_t pressed;
+
+    if (command->length != 7) {
+        monitor_binary_error(e_MON_ERR_CMD_INVALID_LENGTH, command->request_id);
+        return;
+    }
+    key = little_endian_to_uint32(&body[0]);
+    modifiers = little_endian_to_uint16(&body[4]);
+    pressed = body[6];
+    if ((modifiers & ~0x7f) != 0 || pressed > 1) {
+        monitor_binary_error(e_MON_ERR_INVALID_PARAMETER, command->request_id);
+        return;
+    }
+    if (pressed) {
+        keyboard_key_pressed((signed long)key, modifiers);
+    } else {
+        keyboard_key_released((signed long)key, modifiers);
+    }
+    monitor_binary_response(0, e_MON_RESPONSE_HOST_KEY_EVENT,
+                            e_MON_ERR_OK, command->request_id, NULL);
+}
