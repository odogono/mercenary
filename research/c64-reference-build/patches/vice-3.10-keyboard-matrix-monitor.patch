+/* Atomically replace, latch, and event-record the emulated matrix. */
+void keyboard_set_matrix(const uint8_t rows[KBD_ROWS])
+{
+    int row, col;
+
+    for (row = 0; row < KBD_ROWS; row++) {
+        for (col = 0; col < KBD_COLS; col++) {
+            keyboard_set_latch_keyarr(row, col, rows[row] & (1 << col));
+        }
+    }
+    keyboard_latch_matrix(0);
+    keyboard_event_record();
+}
