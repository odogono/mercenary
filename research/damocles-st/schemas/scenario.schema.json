{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Damocles ST observation scenario",
  "type": "object",
  "required": ["schemaVersion", "name", "checkpoint", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "checkpoint": { "const": "title-screen" },
    "joyKeysPort": {
      "type": "integer",
      "enum": [0, 1],
      "description": "Launch Hatari with keyboard emulation on this ST joystick port. Damocles uses port 1."
    },
    "description": { "type": "string" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["wait_vbls", "keypress", "keydown", "keyup", "stick_hold", "capture"]
          },
          "key": {
            "oneOf": [
              { "type": "integer", "minimum": 0, "maximum": 127 },
              { "type": "string", "minLength": 1, "maxLength": 32 }
            ]
          },
          "count": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "direction": {
            "enum": ["up", "down", "left", "right", "fire"]
          },
          "vbls": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "prefix": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["ram", "registers", "display"] }
          }
        }
      }
    }
  }
}
